{
  "name": "ai-idea-hub",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev --webpack --hostname 0.0.0.0",
    "build": "next build --webpack",
    "start": "next start --hostname 0.0.0.0",
    "typecheck": "next typegen && tsc --noEmit",
    "test": "node --experimental-strip-types --test --test-isolation=none tests/*.test.ts",
    "test:browser": "node tests/browser.mjs",
    "test:chat": "node tests/chat-browser.mjs",
    "test:chat-realtime": "node tests/chat-realtime.mjs",
    "test:mcp-client": "node tests/mcp-client.mjs",
    "format": "prettier --write app components lib tests supabase README.md next.config.ts postcss.config.mjs tsconfig.json package.json",
    "format:check": "prettier --check app components lib tests README.md next.config.ts postcss.config.mjs tsconfig.json package.json"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.99.0",
    "next": "^16.2.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.5.14",
    "@modelcontextprotocol/sdk": "^1.32.2",
    "@tailwindcss/postcss": "^4.2.0",
    "@types/node": "^24.0.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "playwright-core": "^1.64.1",
    "prettier": "^3.9.10",
    "tailwindcss": "^4.2.0",
    "typescript": "^5.9.3"
  },
  "type": "module",
  "engines": {
    "node": ">=24 <25"
  }
}
